{
  "name": "sunday-space",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive isometric 3D cozy room built with React, TypeScript, and Three.js. Code-crafted models, warm lighting, and accessible controls.",
  "keywords": [
    "react",
    "typescript",
    "threejs",
    "react-three-fiber",
    "drei",
    "vite",
    "webgl",
    "3d",
    "isometric",
    "cozy-room",
    "interactive-3d",
    "procedural-modeling",
    "accessibility"
  ],
  "homepage": "https://hostlife22.github.io/sunday-space/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hostlife22/sunday-space.git"
  },
  "bugs": {
    "url": "https://github.com/Hostlife22/sunday-space/issues"
  },
  "author": "Hostlife22",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
